<?xml version="1.0" encoding="utf-8"?>
<!--
  Efina mark: an upward trend arrow over a bar chart, inside a rounded speech-bubble
  frame — the same mark the web app ships in public/icon-512.png, redrawn as a vector so
  it stays sharp at every density and can be tinted by the adaptive icon.

  The glyph sits inside the 72dp safe zone of the 108dp adaptive canvas: the launcher
  may mask the outer third, so nothing meaningful is drawn past 54dp from centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bar chart: three rising bars on a baseline. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,64h7v13h-7z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50.5,57h7v20h-7z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,50h7v27h-7z" />

    <!-- Baseline. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,77h40v4h-40z" />

    <!-- Trend arrow, rising left to right, head at the top right. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,68.5l12,-11l8,6.5l11,-13.5l-6,-1.5l14,-6l-2,15l-3,-5.5l-14,17l-8,-6.5l-9,8.5z" />
</vector>
